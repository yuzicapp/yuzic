{
  "name": "yuzic",
  "main": "expo-router/entry",
  "version": "2.9.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:e2e": "maestro test .maestro/smoke.yaml && maestro test .maestro/common-user-flows.yaml && maestro test .maestro/detail-flows.yaml && maestro test .maestro/ratings.yaml",
    "test:e2e:smoke": "maestro test .maestro/smoke.yaml",
    "test:e2e:flows": "maestro test .maestro/common-user-flows.yaml",
    "test:e2e:onboarding": "maestro test .maestro/onboarding-demo.yaml",
    "test:e2e:details": "maestro test .maestro/detail-flows.yaml",
    "test:e2e:ratings": "maestro test .maestro/ratings.yaml",
    "lint": "expo lint",
    "postinstall": "if [ -e node_modules/.bin/patch-package ]; then patch-package --error-on-fail; fi",
    "architecture:check": "node tools/architecture/check-cycles.mjs && node tools/architecture/check-unused.mjs && node tools/architecture/check-provider-branches.mjs && node tools/architecture/check-file-shape.mjs && node tools/architecture/check-unsafe.mjs && node tools/architecture/check-shims.mjs && node tools/architecture/check-test-only-exports.mjs",
    "architecture:prune": "node tools/architecture/check-cycles.mjs --prune && node tools/architecture/check-unused.mjs --prune && node tools/architecture/check-provider-branches.mjs --prune && node tools/architecture/check-file-shape.mjs --prune && node tools/architecture/check-unsafe.mjs --prune && node tools/architecture/check-shims.mjs --prune",
    "architecture:measure": "node tools/architecture/measure.mjs"
  },
  "overrides": {
    "lucide-react-native": {
      "react": "^19"
    }
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^expo-modules-core$": "<rootDir>/node_modules/expo-modules-core",
      "^expo-modules-core/(.*)$": "<rootDir>/node_modules/expo-modules-core/$1",
      "^@missingcore/audio-metadata$": "<rootDir>/__mocks__/audio-metadata.js",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.js",
      "^react-native-reanimated$": "<rootDir>/__mocks__/react-native-reanimated.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|expo-modules-core|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|immer|react-redux)/)"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 71.5,
        "statements": 69.3,
        "functions": 61.4,
        "branches": 62.8
      }
    }
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@missingcore/audio-metadata": "^1.3.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-community/slider": "5.1.2",
    "@react-navigation/native": "^7.0.0",
    "@reduxjs/toolkit": "^2.5.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "^5.90.19",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-persist-client": "^5.90.19",
    "expo": "^55.0.23",
    "expo-blur": "~55.0.14",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.14",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.16",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.8",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.13",
    "expo-router": "~55.0.12",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.18",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.15",
    "expo-web-browser": "~55.0.14",
    "i18next": "^25.8.4",
    "lucide-react-native": "^0.468.0",
    "md5": "^2.3.0",
    "moti": "^0.30.0",
    "react": "19.2.0",
    "react-airplay": "^1.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.5.4",
    "react-native": "^0.83.4",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-exception-handler": "^2.10.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-image-colors": "^1.5.2",
    "react-native-mmkv": "4.3.1",
    "react-native-nitro-modules": "0.35.3",
    "react-native-reanimated": "^4.3.0",
    "react-native-restart": "^0.0.27",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-turbo-image": "1.24.1",
    "react-native-udp": "^4.1.7",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.8.1",
    "react-redux": "^9.2.0",
    "reanimated-color-picker": "^4.2.0",
    "redux-persist": "^6.0.0",
    "yuzic-engine": "1.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.14",
    "@types/react-native-keyboard-spacer": "^0.4.6",
    "baseline-browser-mapping": "^2.9.6",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^55.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "expo-dev-client": "~55.0.27",
    "jest": "^29.2.1",
    "jest-expo": "~55.0.16",
    "madge": "8.0.0",
    "patch-package": "^8.0.1",
    "react-native-svg-transformer": "^1.5.1",
    "test-renderer": "^1.2.0",
    "ts-prune": "0.10.3",
    "typescript": "^5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-community/netinfo",
        "react-native"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-exception-handler",
          "react-airplay",
          "react-native-restart"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
